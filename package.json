{
  "name": "hallway",
  "productName": "Hallway",
  "version": "1.3.1",
  "description": "Hallway — serverless office messenger for the local network: UDP discovery, TCP chat and file transfer",
  "author": "grigoriapps <grigoriapps@gmail.com>",
  "license": "MIT",
  "private": true,
  "main": "./out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:second": "cross-env HALLWAY_PROFILE=second electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json",
    "test": "npm run test:unit && npm run test:net",
    "test:unit": "tsx scripts/unit-test.ts",
    "test:net": "tsx scripts/net-smoke-test.ts",
    "icons": "electron scripts/generate-icons.cjs",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:all": "npm run build && electron-builder --mac --win"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  }
}
